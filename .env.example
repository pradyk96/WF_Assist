# Copy this file to .env on your own computer. Never commit the real .env file.
OPENAI_API_KEY=replace_with_a_new_private_key

# General assistant
OPENAI_MODEL=gpt-4.1-mini

# Real-time speech-to-speech conversation
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-realtime-whisper

# Request-based fallback voice pipeline
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Local development defaults to localhost. Add real domains after deployment.
# ALLOWED_ORIGINS=https://wingsforever.pro,https://www.wingsforever.pro
